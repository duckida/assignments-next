{
  "manifest_version": 3,
  "name": "Assignments+ — Material UI for Teams",
  "short_name": "Assignments+",
  "version": "0.1.8",
  "description": "A Material 3 alternative frontend for Teams Assignments, for students. Read, attach work to, and turn in your own assignments via the session you already have in Teams Web.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://graph.microsoft.com/*",
    "https://edu.microsoft.com/*",
    "https://teams.microsoft.com/*",
    "https://*.teams.microsoft.com/*",
    "https://*.cloud.microsoft/*",
    "https://teams.live.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "assets/background.js"
  },
  "action": {
    "default_title": "Open Assignments+ dashboard"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://*.cloud.microsoft/*",
        "https://teams.live.com/*",
        "https://edu.microsoft.com/*"
      ],
      "js": ["assets/capture.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://*.cloud.microsoft/*",
        "https://teams.live.com/*",
        "https://edu.microsoft.com/*"
      ],
      "js": ["assets/bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
